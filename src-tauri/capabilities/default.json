{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "opener:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**/*" },
        { "path": "$DOCUMENT/**/*" },
        { "path": "$DOWNLOAD/**/*" },
        { "path": "$DESKTOP/**/*" },
        { "path": "$APPDATA/**/*" },
        { "path": "$APPLOCALDATA/**/*" },
        { "path": "$APPCONFIG/**/*" },
        { "path": "$TEMP/**/*" }
      ]
    },
    "deep-link:default"
  ]
}
